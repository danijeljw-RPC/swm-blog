---
import CelestialMark from "../components/common/CelestialMark.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Page not found" noindex={true}>
  <section class="page-section site-container not-found"><CelestialMark variant="moon" /><p>404</p><h1>The mirror is dark here</h1><p>The page you requested could not be found.</p><a class="button" href="/">Return home</a></section>
</BaseLayout>
<style>.not-found { display: grid; min-height: 34rem; align-content: center; justify-items: center; text-align: center; } .not-found > p:first-of-type { color: var(--swm-gold-light); } .not-found h1 { font-size: clamp(3rem, 8vw, 6rem); }</style>
