---
import { getCollection, type CollectionEntry } from "astro:content";
import EpisodeCard from "../../components/episodes/EpisodeCard.astro";
import ArticleCard from "../../components/articles/ArticleCard.astro";
import SectionHeading from "../../components/common/SectionHeading.astro";
import { CATEGORY_KEYS, getCategoryLabel, type CategoryKey } from "../../config/categories";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getEntriesByCategory, type CategoryEntry } from "../../utils/category-entries";

export const prerender = true;

export async function getStaticPaths() {
  const allEpisodes = await getCollection("episodes");
  const allArticles = await getCollection("articles");
  return CATEGORY_KEYS.map((category) => ({ params: { category }, props: { category, entries: getEntriesByCategory(allEpisodes, allArticles, category) } }));
}
interface Props { category: CategoryKey; entries: CategoryEntry<CollectionEntry<"episodes">, CollectionEntry<"articles">>[]; }
const { category, entries } = Astro.props;
const label = getCategoryLabel(category);
---
<BaseLayout title={label} description={`Sisters with Mirrors episodes and articles in ${label}.`}>
  <section class="page-section site-container">
    <SectionHeading title={label} introduction="Episodes and articles filed under this theme." />
    {entries.length ? <div class="grid">{entries.map((item) => item.kind === "episode" ? <EpisodeCard entry={item.entry} /> : <ArticleCard entry={item.entry} />)}</div> : <p>No published entries use this category yet.</p>}
    <p class="back"><a href="/categories/">Browse all categories</a></p>
  </section>
</BaseLayout>
<style>.grid { display: grid; gap: var(--space-4); } .back { margin-top: var(--space-5); } @media (min-width: 42rem) { .grid { grid-template-columns: repeat(2, 1fr); } } @media (min-width: 68rem) { .grid { grid-template-columns: repeat(3, 1fr); } }</style>
