---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { ELEMENTS, PLANETS, ZODIAC_REFERENCES, referenceImagePath } from "../../utils/astrology-reference";
---

<BaseLayout title="Astrology" description="Live horoscopes and an interconnected guide to zodiac signs, planets and the four classical elements.">
  <section class="astrology-intro site-container">
    <p>Daily astrology</p>
    <h1>The sky, guides.</h1>
    <span aria-hidden="true"></span>
    <p>Choose your sign for a live reflection. Daily and weekly readings are drawn when you open the page.</p>
  </section>
  <section class="zodiac-selector site-container" aria-label="Choose your zodiac sign">
    {ZODIAC_REFERENCES.map(({ slug, data }) => <a href={`/astrology/${slug}/`} class="zodiac-sign"><img src={referenceImagePath("zodiac", slug)} alt="" width="128" height="128" /><span>{data.name}</span><small>{data.approximate_tropical_dates}</small></a>)}
  </section>
  <section class="library site-container">
    <header><p>The reference library</p><h2>Follow the connections</h2><p>Every symbol opens into the others: a sign has an element and ruler; an element gathers three signs; a planet reveals where its influence is traditionally at home.</p></header>
    <div class="library-grid">
      <a href="/astrology/zodiac/" class="library-card"><div class="art-stack">{ZODIAC_REFERENCES.slice(0, 3).map(({ slug }) => <img src={referenceImagePath("zodiac", slug)} alt="" />)}</div><span>12 signs</span><h3>Zodiac</h3><p>Archetypes, strengths, shadows, relationships and spiritual lessons.</p></a>
      <a href="/astrology/planets/" class="library-card"><div class="art-stack">{PLANETS.slice(0, 3).map(({ slug }) => <img src={referenceImagePath("planets", slug)} alt="" />)}</div><span>11 celestial influences</span><h3>Planets</h3><p>Purpose, expression, chart themes and the signs each body rules.</p></a>
      <a href="/astrology/elements/" class="library-card"><div class="art-stack">{ELEMENTS.slice(0, 3).map(({ slug }) => <img src={referenceImagePath("elements", slug)} alt="" />)}</div><span>4 foundations</span><h3>Elements</h3><p>Fire, Earth, Air and Water as temperaments, needs and ways of moving.</p></a>
      <a href="/astrology/birth-chart/" class="library-card"><div class="art-stack art-stack--single"><img src="/images/birth-chart.png" alt="" /></div><span>Calculated live</span><h3>Birth Chart</h3><p>Enter your date, time and place of birth to generate your natal chart in your browser.</p></a>
    </div>
    <p class="tradition-note">This library presents astrology as a symbolic and reflective tradition, not a scientific claim or fixed account of personality.</p>
  </section>
</BaseLayout>
<style>
  .astrology-intro { display: grid; grid-template-columns: minmax(0, 1fr) 4rem minmax(0, 1fr); align-items: end; gap: var(--space-3); padding-block: clamp(2rem, 7vw, 6rem) var(--space-5); }
  .astrology-intro > p:first-child, .library header > p { grid-column: 1 / -1; margin: 0; color: var(--swm-gold); font-size: .75rem; letter-spacing: .13em; text-transform: uppercase; }
  .astrology-intro h1 { margin: 0; font-size: clamp(3.2rem, 8vw, 6.5rem); }
  .astrology-intro > span { height: 9rem; background: linear-gradient(var(--swm-gold), transparent); clip-path: polygon(49% 0, 51% 0, 51% 100%, 49% 100%); }
  .astrology-intro > p:last-child { max-width: 27rem; margin: 0 0 .45rem; color: var(--swm-text-muted); }
  .zodiac-selector { display: grid; border-top: 1px solid var(--swm-border); border-left: 1px solid var(--swm-border); grid-template-columns: repeat(2, 1fr); }
  .zodiac-sign { display: grid; min-height: 11rem; place-items: center; align-content: center; gap: .2rem; padding: var(--space-3); border-right: 1px solid var(--swm-border); border-bottom: 1px solid var(--swm-border); text-align: center; text-decoration: none; background: rgb(18 13 23 / 35%); }
  .zodiac-sign:hover { background: rgb(169 136 83 / 9%); }
  .zodiac-sign img { width: 3.7rem; height: 3.7rem; object-fit: contain; }
  .zodiac-sign span { color: var(--swm-ivory); font-family: var(--font-display); font-size: 1.7rem; }
  .zodiac-sign small { color: var(--swm-text-muted); font-size: .68rem; }
  .library { padding-block: var(--space-7); } .library header { max-width: 48rem; margin-bottom: var(--space-5); } .library-grid { display: grid; gap: var(--space-3); } .library-card { min-height: 27rem; padding: var(--space-4); border: 1px solid var(--swm-border-soft); text-decoration: none; background: linear-gradient(150deg, rgb(23 19 28 / 62%), rgb(7 7 11 / 84%)); }
  .art-stack { position: relative; height: 12rem; margin-bottom: var(--space-3); } .art-stack img { position: absolute; top: 0; left: 50%; width: 9rem; height: 10rem; object-fit: contain; transform: translateX(-50%); filter: drop-shadow(0 .8rem 1rem rgb(0 0 0 / 45%)); } .art-stack img:first-child { left: 30%; transform: translateX(-50%) rotate(-9deg); } .art-stack img:last-child { left: 70%; transform: translateX(-50%) rotate(9deg); }
  .art-stack--single img:first-child:last-child { left: 50%; transform: translateX(-50%); }
  .library-card > span { color: var(--swm-gold); font-size: .72rem; } .library-card h3 { margin: .15rem 0 .6rem; font-size: 2.7rem; } .library-card p { color: var(--swm-text-muted); font-size: .87rem; } .tradition-note { max-width: 46rem; padding-top: var(--space-4); color: var(--swm-text-muted); font-size: .72rem; }
  @media (min-width: 42rem) { .zodiac-selector { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 64rem) { .zodiac-selector { grid-template-columns: repeat(6, 1fr); } .zodiac-sign { min-height: 13rem; } .library-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 41.99rem) { .astrology-intro { grid-template-columns: 1fr; } .astrology-intro > span { display: none; } }
</style>
