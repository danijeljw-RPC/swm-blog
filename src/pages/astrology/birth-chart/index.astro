---
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Birth Chart"
  description="Generate a natal chart from your date, time and place of birth, calculated in your browser."
>
  <section class="chart-intro site-container">
    <p>Natal chart</p>
    <h1>Map your sky.</h1>
    <span aria-hidden="true"></span>
    <p>
      Enter your date, time and place of birth.
    </p>
  </section>

  <section class="chart-workspace site-container">
    <form id="birth-chart-form" class="framed-panel chart-form" autocomplete="off">
      <div class="field">
        <label for="birth-date">Date of birth</label>
        <input type="date" id="birth-date" name="date" required />
      </div>

      <div class="field">
        <label for="birth-time">Time of birth</label>
        <input type="time" id="birth-time" name="time" required />
      </div>

      <div class="field place-field">
        <label for="birth-place">Place of birth</label>
        <input
          type="text"
          id="birth-place"
          name="place"
          placeholder="Start typing a city&hellip;"
          required
        />
        <input type="hidden" id="birth-place-data" name="place-data" />
        <div id="place-results" class="place-results" role="listbox" hidden></div>
      </div>

      <p id="chart-status" class="chart-status" role="alert" hidden></p>

      <button type="submit" id="chart-submit" class="button">
        Generate birth chart
      </button>
    </form>

    <div id="chart-result" class="chart-output" role="region" aria-label="Generated birth chart">
      <div id="chart-art" class="chart-art" hidden></div>
      <div id="chart-summary" class="chart-summary" hidden></div>
      <button type="button" id="chart-download" class="button chart-download" hidden>Download your chart guide</button>
    </div>
  </section>
  <p class="chart-tradition site-container">This birth chart is offered as part of a symbolic and reflective tradition, not as a scientific claim or fixed account of personality.</p>
</BaseLayout>

<script>
  import { initPlaceAutocomplete } from "../../../components/astrology/PlaceAutocomplete";
  import { initBirthChartForm } from "../../../components/astrology/NatalChart";

  const form = document.getElementById("birth-chart-form") as HTMLFormElement;
  const placeInput = document.getElementById("birth-place") as HTMLInputElement;
  const placeField = document.getElementById("birth-place-data") as HTMLInputElement;
  const placeResults = document.getElementById("place-results") as HTMLElement;
  const dateField = document.getElementById("birth-date") as HTMLInputElement;
  const timeField = document.getElementById("birth-time") as HTMLInputElement;
  const submitButton = document.getElementById("chart-submit") as HTMLButtonElement;
  const statusEl = document.getElementById("chart-status") as HTMLElement;
  const chartArt = document.getElementById("chart-art") as HTMLElement;
  const chartSummary = document.getElementById("chart-summary") as HTMLElement;
  const downloadButton = document.getElementById("chart-download") as HTMLButtonElement;

  initPlaceAutocomplete({
    input: placeInput,
    resultsContainer: placeResults,
    hiddenField: placeField
  });

  initBirthChartForm({
    form,
    placeInput,
    placeField,
    dateField,
    timeField,
    submitButton,
    statusEl,
    chartArt,
    chartSummary,
    downloadButton
  });
</script>

<style>
  .chart-intro { display: grid; grid-template-columns: minmax(0, 1fr) 4rem minmax(0, 1fr); align-items: end; gap: var(--space-3); padding-block: clamp(2rem, 7vw, 6rem) var(--space-5); }
  .chart-intro > p:first-child { grid-column: 1 / -1; margin: 0; color: var(--swm-gold); font-size: .75rem; letter-spacing: .13em; text-transform: uppercase; }
  .chart-intro h1 { margin: 0; font-size: clamp(3.2rem, 8vw, 6.5rem); }
  .chart-intro > span { height: 9rem; background: linear-gradient(var(--swm-gold), transparent); clip-path: polygon(49% 0, 51% 0, 51% 100%, 49% 100%); }
  .chart-intro > p:last-child { max-width: 27rem; margin: 0 0 .45rem; color: var(--swm-text-muted); }

  .chart-workspace { display: grid; gap: var(--space-4); padding-block: var(--space-5) var(--space-7); }

  .chart-form { position: relative; display: grid; gap: var(--space-3); padding: var(--space-4); }
  .field { display: grid; gap: .4rem; }
  .field label { color: var(--swm-gold-light); font-size: .78rem; letter-spacing: .04em; text-transform: uppercase; }
  .field input[type="date"],
  .field input[type="time"],
  .field input[type="text"] {
    padding: .7rem .85rem;
    border: 1px solid var(--swm-border-soft);
    border-radius: var(--radius-small);
    color: var(--swm-text);
    background: var(--swm-panel);
  }
  .field input:focus-visible { border-color: var(--swm-gold); }

  .place-field { position: relative; }
  .place-results {
    position: absolute;
    z-index: 10;
    top: 100%;
    left: 0;
    display: grid;
    overflow: hidden;
    width: 100%;
    margin-top: .3rem;
    border: 1px solid var(--swm-border);
    border-radius: var(--radius-small);
    background: var(--swm-panel-raised);
    box-shadow: 0 1rem 2rem rgb(0 0 0 / 45%);
  }
  .place-results :global(.place-option) {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    padding: .6rem .85rem;
    border: 0;
    border-bottom: 1px solid var(--swm-border-soft);
    color: var(--swm-text);
    font: inherit;
    text-align: left;
    background: transparent;
    cursor: pointer;
  }
  .place-results :global(.place-option:last-child) { border-bottom: 0; }
  .place-results :global(.place-option:hover) { background: rgb(169 136 83 / 12%); }
  .place-results :global(.place-option-label) { color: var(--swm-ivory); font-size: .92rem; }
  .place-results :global(.place-option small) { color: var(--swm-text-muted); font-size: .72rem; white-space: nowrap; }

  .chart-status { margin: 0; padding: .65rem .85rem; border: 1px solid var(--swm-danger); border-radius: var(--radius-small); color: var(--swm-danger); font-size: .84rem; background: rgb(214 167 167 / 8%); }

  .chart-output { display: grid; gap: var(--space-3); }
  .chart-art { display: grid; place-items: center; padding: var(--space-3); border: 1px solid var(--swm-border-soft); background: radial-gradient(circle, rgb(169 136 83 / 10%), transparent 68%); }
  .chart-art :global(svg) { width: 100%; max-width: 32rem; height: auto; }
  .chart-art :global(.zodiac-outer) { fill: none; stroke: var(--swm-gold); stroke-width: 2; }
  .chart-art :global(.aspect-inner) { fill: rgb(7 7 11 / 34%); stroke: var(--swm-border); stroke-width: 1.5; }
  .chart-art :global(.house-line) { stroke: rgb(215 204 184 / 42%); stroke-width: 1.2; }
  .chart-art :global(.house-number) { fill: var(--swm-gold-light); font-family: var(--font-sans); font-size: 1.15rem; }
  .chart-art :global(.aspect) { stroke-width: 1.8; opacity: .78; }
  .chart-art :global(.aspect-trine),
  .chart-art :global(.aspect-sextile) { stroke: var(--swm-gold-light); }
  .chart-art :global(.aspect-square),
  .chart-art :global(.aspect-opposition) { stroke: var(--swm-danger); }
  .chart-art :global(.aspect-conjunction) { stroke: var(--swm-ivory); }
  .chart-art :global(.planet-guide) { stroke: var(--swm-gold); stroke-width: 1; opacity: .7; }
  .chart-art :global(.planet-marker) { fill: var(--swm-panel-raised); stroke: var(--swm-gold); stroke-width: 1.5; }
  .chart-art :global(.planet) { fill: var(--swm-ivory); font-size: 1.65rem; }

  .chart-summary { display: grid; gap: var(--space-5); }
  .chart-summary :global(.section-heading) { max-width: 48rem; }
  .chart-summary :global(.section-heading > p:first-child), .chart-summary :global(.chart-legend > div > p) { margin: 0; color: var(--swm-gold); font-size: .7rem; letter-spacing: .1em; text-transform: uppercase; }
  .chart-summary :global(.section-heading h2), .chart-summary :global(.chart-legend h2) { margin: .15rem 0 .5rem; font-size: clamp(2rem, 5vw, 3.4rem); }
  .chart-summary :global(.section-heading > p:last-child) { margin: 0; color: var(--swm-text-muted); }
  .chart-summary :global(.headline-grid), .chart-summary :global(.placement-grid) { display: grid; gap: var(--space-2); }
  .chart-summary :global(.headline-card), .chart-summary :global(.placement-card) { padding: var(--space-3); border: 1px solid var(--swm-border-soft); background: rgb(13 11 17 / 72%); }
  .chart-summary :global(.headline-card > span) { color: var(--swm-gold); font-size: .7rem; letter-spacing: .08em; text-transform: uppercase; }
  .chart-summary :global(.headline-card > strong) { display: block; margin: .15rem 0 .55rem; color: var(--swm-ivory); font-family: var(--font-display); font-size: 1.65rem; font-weight: 500; }
  .chart-summary :global(.headline-card p), .chart-summary :global(.placement-card p), .chart-summary :global(.aspect-list p) { margin: 0; color: var(--swm-text-muted); font-size: .86rem; }
  .chart-summary :global(.chart-legend) { display: grid; gap: var(--space-3); padding: var(--space-4); border: 1px solid var(--swm-border); background: linear-gradient(150deg, rgb(23 19 28 / 88%), rgb(7 7 11 / 92%)); }
  .chart-summary :global(.chart-legend ul) { display: grid; gap: .7rem; margin: 0; padding: 0; list-style: none; }
  .chart-summary :global(.chart-legend li) { display: grid; grid-template-columns: 2rem 5rem 1fr; align-items: center; gap: .65rem; color: var(--swm-text-muted); font-size: .78rem; }
  .chart-summary :global(.chart-legend strong) { color: var(--swm-ivory); }
  .chart-summary :global(.legend-key) { width: 1.5rem; height: 1px; background: var(--swm-ivory); }
  .chart-summary :global(.legend-key--planet) { width: .7rem; height: .7rem; margin-left: .4rem; border-radius: 50%; background: var(--swm-ivory); }
  .chart-summary :global(.legend-key--sign) { height: .7rem; border: 1px solid var(--swm-gold); background: transparent; }
  .chart-summary :global(.legend-key--house) { background: rgb(215 204 184 / 45%); }
  .chart-summary :global(.legend-key--gold) { background: var(--swm-gold-light); }
  .chart-summary :global(.legend-key--rose) { background: var(--swm-danger); }
  .chart-summary :global(.placement-card header) { display: flex; align-items: center; gap: .8rem; margin-bottom: var(--space-2); }
  .chart-summary :global(.placement-symbol) { display: grid; width: 2.6rem; height: 2.6rem; place-items: center; flex: 0 0 auto; border: 1px solid var(--swm-border); border-radius: 50%; color: var(--swm-gold-light); font-size: 1.35rem; }
  .chart-summary :global(.placement-card h3) { margin: 0; font-size: 1.45rem; }
  .chart-summary :global(.placement-card header p), .chart-summary :global(.placement-role) { color: var(--swm-gold); font-size: .72rem; }
  .chart-summary :global(.placement-role) { margin-bottom: .55rem; text-transform: uppercase; }
  .chart-summary :global(.aspect-list) { display: grid; gap: var(--space-2); margin: var(--space-3) 0 0; padding: 0; list-style: none; }
  .chart-summary :global(.aspect-list li) { display: grid; grid-template-columns: 2.5rem 1fr; gap: var(--space-2); padding: var(--space-2); border-bottom: 1px solid var(--swm-border-soft); }
  .chart-summary :global(.aspect-symbol) { color: var(--swm-gold); font-size: 1.5rem; text-align: center; }
  .chart-summary :global(.aspect-list strong), .chart-summary :global(.aspect-list small) { display: block; }
  .chart-summary :global(.aspect-list small) { margin: .1rem 0 .4rem; color: var(--swm-gold); font-size: .7rem; }
  .chart-summary :global(.empty-aspects), .chart-summary :global(.chart-disclaimer) { color: var(--swm-text-muted); font-size: .78rem; }
  .chart-summary :global(.technical-details) { padding: var(--space-3); border: 1px solid var(--swm-border-soft); background: rgb(13 11 17 / 72%); }
  .chart-summary :global(.technical-details summary) { color: var(--swm-ivory); font-family: var(--font-display); font-size: 1.35rem; cursor: pointer; }
  .chart-summary :global(.technical-meta) { display: grid; gap: .4rem; margin-block: var(--space-3); }
  .chart-summary :global(.technical-meta p) { display: grid; grid-template-columns: 8rem 1fr; margin: 0; color: var(--swm-text-muted); font-size: .78rem; }
  .chart-summary :global(.technical-meta strong) { color: var(--swm-gold-light); }
  .chart-summary :global(.table-scroll) { overflow-x: auto; }
  .chart-summary :global(.planet-table) { width: 100%; min-width: 28rem; border-collapse: collapse; font-size: .82rem; }
  .chart-summary :global(.planet-table th), .chart-summary :global(.planet-table td) { padding: .45rem .3rem; color: var(--swm-text); text-align: left; border-bottom: 1px solid var(--swm-border-soft); }
  .chart-summary :global(.planet-table thead th) { color: var(--swm-gold-light); font-size: .68rem; text-transform: uppercase; }
  .chart-download { justify-self: start; }
  .chart-tradition { margin-top: calc(var(--space-7) * -1); padding-bottom: var(--space-7); color: var(--swm-text-muted); font-size: .72rem; }

  @media (min-width: 48rem) { .chart-summary :global(.headline-grid) { grid-template-columns: repeat(2, 1fr); } .chart-summary :global(.placement-grid) { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 64rem) { .chart-workspace { grid-template-columns: minmax(0, 22rem) minmax(0, 1fr); align-items: start; } }
  @media (max-width: 41.99rem) { .chart-intro { grid-template-columns: 1fr; } .chart-intro > span { display: none; } }
</style>
