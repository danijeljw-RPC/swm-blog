---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ReferenceCard from "../../../components/astrology/ReferenceCard.astro";
import { ZODIAC_REFERENCES, getPlanet, referenceImagePath } from "../../../utils/astrology-reference";
---
<BaseLayout title="Zodiac signs" description="Explore the twelve zodiac signs, their elements, ruling planets, strengths and growth paths.">
  <section class="collection-intro site-container"><p><a href="/astrology/">Astrology</a> / Zodiac</p><h1>Twelve ways<br />to meet the sky.</h1><p>Explore each sign as an archetype: its natural gifts, its growing edges, and the element and planet that connect it to the wider astrological system.</p></section>
  <section class="reference-grid site-container" aria-label="Zodiac signs">{ZODIAC_REFERENCES.map(({ slug, data }) => <ReferenceCard href={`/astrology/zodiac/${slug}/`} image={referenceImagePath("zodiac", slug)} symbol={data.symbol} title={data.name} description={data.metaphysical_interpretation} meta={`${data.approximate_tropical_dates} · ${getPlanet(data.ruling_planet)?.name}`} />)}</section>
</BaseLayout>
<style>
  .collection-intro { display: grid; gap: var(--space-3); padding-block: var(--space-6); } .collection-intro > p:first-child { color: var(--swm-gold); font-size: .75rem; } h1 { max-width: 11ch; } .collection-intro > p:last-child { max-width: 42rem; color: var(--swm-text-muted); } .reference-grid { display: grid; gap: var(--space-3); padding-bottom: var(--space-7); }
  @media (min-width: 42rem) { .collection-intro { grid-template-columns: 1.2fr .8fr; align-items: end; } .collection-intro > p:first-child { grid-column: 1 / -1; } .reference-grid { grid-template-columns: repeat(2, 1fr); } } @media (min-width: 64rem) { .reference-grid { grid-template-columns: repeat(3, 1fr); } }
</style>
