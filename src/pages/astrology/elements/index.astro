---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ReferenceCard from "../../../components/astrology/ReferenceCard.astro";
import { ELEMENTS, referenceImagePath } from "../../../utils/astrology-reference";
---
<BaseLayout title="The four elements" description="Explore Fire, Earth, Air and Water in astrological and metaphysical traditions.">
  <section class="astrology-intro site-container">
    <p>Astrology reference</p>
    <h1>The four temperaments.</h1>
    <span aria-hidden="true"></span>
    <p>Fire initiates. Earth builds. Air connects. Water feels. The elements describe four symbolic ways energy can move, respond and find balance.</p>
  </section>
  <section class="reference-grid site-container" aria-label="Classical elements">{ELEMENTS.map(({ slug, data }) => <ReferenceCard href={`/astrology/elements/${slug}/`} image={referenceImagePath("elements", slug)} symbol={data.symbol} title={data.name} description={data.description} meta={`${data.associated_direction} · ${data.associated_season} · ${data.associated_tarot_suit}`} />)}</section>
</BaseLayout>
<style>
  .astrology-intro { display: grid; grid-template-columns: minmax(0, 1fr) 4rem minmax(0, 1fr); align-items: end; gap: var(--space-3); padding-block: clamp(2rem, 7vw, 6rem) var(--space-5); }
  .astrology-intro > p:first-child { grid-column: 1 / -1; margin: 0; color: var(--swm-gold); font-size: .75rem; letter-spacing: .13em; text-transform: uppercase; }
  .astrology-intro h1 { margin: 0; font-size: clamp(3.2rem, 8vw, 6.5rem); }
  .astrology-intro > span { height: 9rem; background: linear-gradient(var(--swm-gold), transparent); clip-path: polygon(49% 0, 51% 0, 51% 100%, 49% 100%); }
  .astrology-intro > p:last-child { max-width: 27rem; margin: 0 0 .45rem; color: var(--swm-text-muted); }
  .reference-grid { display: grid; gap: var(--space-3); padding-bottom: var(--space-7); }
  @media (min-width: 42rem) { .reference-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 41.99rem) { .astrology-intro { grid-template-columns: 1fr; } .astrology-intro > span { display: none; } }
</style>
