---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getZodiacSign, ZODIAC_SIGNS } from "../../config/zodiac";
import { getHoroscope, type HoroscopePeriod, type HoroscopeResult } from "../../utils/horoscope";

export const prerender = false;

const sign = getZodiacSign(Astro.params.sign?.toLowerCase());
const period: HoroscopePeriod = Astro.url.searchParams.get("period") === "weekly" ? "weekly" : "daily";
let horoscope: HoroscopeResult | null = null;
if (sign) {
  try { horoscope = await getHoroscope(sign.slug, period); } catch { Astro.response.status = 503; }
} else {
  Astro.response.status = 404;
}
Astro.response.headers.set("Cache-Control", "public, max-age=0, s-maxage=900");
---
<BaseLayout title={sign ? `${sign.name} horoscope` : "Sign not found"} description={sign ? `Live ${period} horoscope for ${sign.name}.` : "The requested zodiac sign was not found."} noindex={!sign}>
  {sign ? <section class="horoscope-page site-container">
    <header class="sign-header"><a href="/astrology/">All signs</a><div><img src={`/images/zodiac/${sign.slug}.png`} alt="" width="200" height="200" /><p>{sign.dateRange}</p><h1>{sign.name}</h1></div><p>Your {period} reflection.</p></header>
    <nav class="period-switch" aria-label="Horoscope period"><a class:list={{ active: period === "daily" }} href={`/astrology/${sign.slug}/`}>Daily</a><a class:list={{ active: period === "weekly" }} href={`/astrology/${sign.slug}/?period=weekly`}>Weekly</a><a href={`/astrology/zodiac/${sign.slug}/`}>Meet {sign.name}</a></nav>
    {horoscope ? <article class="horoscope-reading framed-panel"><p class="reading-meta">{horoscope.period} · {horoscope.date}</p><p class="horoscope-copy">{horoscope.horoscope}</p><p class="provider-note">Live reading provided by Free Horoscope API.</p></article> : <article class="unavailable framed-panel"><h2>This reading is unavailable right now.</h2><p>The live horoscope provider did not return a usable response. Please try again shortly.</p></article>}
    <nav class="sign-links" aria-label="Other zodiac signs">{ZODIAC_SIGNS.map((other) => <a href={`/astrology/${other.slug}/`} aria-current={other.slug === sign.slug ? "page" : undefined}>{other.name}</a>)}</nav>
  </section> : <section class="missing-sign site-container"><h1>That sign could not be found.</h1><a class="button" href="/astrology/">Choose a zodiac sign</a></section>}
</BaseLayout>
<style>
  .horoscope-page { padding-block: var(--space-4) var(--space-7); } .sign-header { display: grid; grid-template-columns: 1fr auto 1fr; align-items: end; gap: var(--space-3); margin-bottom: var(--space-4); } .sign-header > a { color: var(--swm-text-muted); font-size: .78rem; } .sign-header > div { display: grid; justify-items: center; text-align: center; } .sign-header img { width: clamp(4.75rem, 11vw, 7rem); height: clamp(4.75rem, 11vw, 7rem); object-fit: contain; } .sign-header p { margin: 0; color: var(--swm-text-muted); font-size: .78rem; } .sign-header div p { color: var(--swm-gold); } .sign-header h1 { margin: 0; font-size: clamp(3rem, 8vw, 6rem); } .sign-header > p { text-align: right; }
  .period-switch { display: flex; flex-wrap: wrap; justify-content: center; margin-bottom: var(--space-3); } .period-switch a { min-width: 7rem; padding: .55rem 1rem; border: 1px solid var(--swm-border); color: var(--swm-text-muted); font-size: .8rem; text-align: center; text-decoration: none; } .period-switch a + a { margin-left: -1px; } .period-switch a.active { color: var(--swm-bg); background: var(--swm-gold); }
  .horoscope-reading, .unavailable { width: min(100%, 52rem); padding: clamp(1.5rem, 5vw, 3.5rem); margin-inline: auto; } .horoscope-reading > *, .unavailable > * { position: relative; z-index: 1; } .reading-meta { margin-bottom: var(--space-3); color: var(--swm-gold); font-size: .72rem; letter-spacing: .13em; text-transform: uppercase; } .horoscope-copy { max-width: 42rem; margin: 0; font-family: var(--font-display); font-size: clamp(1.55rem, 3.3vw, 2.25rem); line-height: 1.32; } .provider-note { margin: var(--space-4) 0 0; color: var(--swm-text-muted); font-size: .72rem; } .unavailable { text-align: center; } .unavailable h2 { font-size: clamp(2rem, 5vw, 3.3rem); } .unavailable p { color: var(--swm-text-muted); }
  .sign-links { display: flex; flex-wrap: wrap; justify-content: center; gap: .25rem .75rem; max-width: 53rem; padding-top: var(--space-4); margin: var(--space-4) auto 0; border-top: 1px solid var(--swm-border-soft); } .sign-links a { padding: .25rem; color: var(--swm-text-muted); font-size: .75rem; text-decoration: none; } .sign-links a[aria-current="page"] { color: var(--swm-gold-light); } .missing-sign { display: grid; min-height: 50vh; place-content: center; gap: var(--space-3); text-align: center; }
  @media (max-width: 41.99rem) { .sign-header { grid-template-columns: 1fr; justify-items: center; text-align: center; } .sign-header > p { text-align: center; } }
</style>
