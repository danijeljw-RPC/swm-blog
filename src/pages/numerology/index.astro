---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ReferencePageHero from "../../components/layout/ReferencePageHero.astro";
import numerology from "../../data/numerology.json";

const numbers = numerology as NumerologyEntry[];
interface NumerologyEntry { number: number; title: string; energy: string; }
---

<BaseLayout title="Numerology" description="A reflective guide to the symbolic meaning, energy, strengths and challenges of numbers one to one hundred.">
  <ReferencePageHero eyebrow="Numerology reference" title="Numbers in the mirror." description="Every number carries a different rhythm. Choose a number to explore its symbolism, energy, gifts, growing edges and invitation for reflection." />
  <main class="numerology-page site-container">
    <section class="number-grid" aria-label="Choose a number">
      {numbers.map((entry) => (
        <a href={`/numerology/${entry.number}/`} class="number-card">
          <span class="number-card__number">{entry.number}</span>
          <span class="number-card__title">{entry.title}</span>
          <span class="number-card__energy">{entry.energy}</span>
        </a>
      ))}
    </section>
  </main>
</BaseLayout>

<style>
  .numerology-page { padding-bottom: var(--space-7); }
  .number-grid { display: grid; grid-template-columns: repeat(2, 1fr); border-top: 1px solid var(--swm-border); border-left: 1px solid var(--swm-border); }
  .number-card { display: grid; min-height: 12rem; align-content: end; gap: .35rem; padding: var(--space-3); border-right: 1px solid var(--swm-border); border-bottom: 1px solid var(--swm-border); text-decoration: none; background: linear-gradient(145deg, rgb(23 19 28 / 58%), rgb(7 7 11 / 84%)); transition: background .2s ease, transform .2s ease; }
  .number-card:hover { background: rgb(169 136 83 / 10%); transform: translateY(-2px); }
  .number-card__number { color: var(--swm-gold); font-family: var(--font-display); font-size: 4.5rem; line-height: .8; }
  .number-card__title { color: var(--swm-ivory); font-family: var(--font-display); font-size: 1.55rem; }
  .number-card__energy { color: var(--swm-text-muted); font-size: .72rem; line-height: 1.5; }
  @media (min-width: 42rem) { .number-grid { grid-template-columns: repeat(4, 1fr); } .number-card { min-height: 14rem; } }
  @media (min-width: 64rem) { .number-grid { grid-template-columns: repeat(5, 1fr); } }
</style>
