---
import HostCard from "../../components/hosts/HostCard.astro";
import SectionHeading from "../../components/common/SectionHeading.astro";
import about from "../../data/about.json";
import hosts from "../../data/hosts.json";
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout title="About" description={about.introduction}>
  <section class="page-section site-container">
    <SectionHeading title={about.title} introduction={about.introduction} />
    <div class="about-copy">
      {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      <p class="closing-statement">{about.closingStatement}</p>
    </div>
    <div class="grid">{hosts.map((host) => <HostCard host={host} />)}</div>
  </section>
</BaseLayout>
<style>
  .about-copy { max-width: 44rem; margin-bottom: var(--space-6); color: var(--swm-text-muted); }
  .about-copy p { margin: 0 0 var(--space-4); }
  .closing-statement { color: var(--swm-gold-light); font-family: var(--font-display); font-size: 1.35rem; font-weight: 600; line-height: 1.35; }
  .grid { display: grid; gap: var(--space-4); }
  @media (min-width: 48rem) { .grid { grid-template-columns: repeat(2, 1fr); } }
</style>
