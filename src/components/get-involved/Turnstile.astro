---
interface Props { siteKey: string; action: "share-story" | "be-a-guest"; }
const { siteKey, action } = Astro.props;
---
<div class="turnstile-wrap">
  <div class="cf-turnstile" data-sitekey={siteKey} data-action={action} data-theme="dark"></div>
  <p class="field-error" data-error-for="turnstileToken"></p>
</div>
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
