---
interface Props { title: string; href: string; cta: string; mark: string; }
const { title, href, cta, mark } = Astro.props;
---
<article class="involved-card framed-panel"><span class="card-mark" aria-hidden="true">{mark}</span><h2>{title}</h2><div class="card-copy"><slot /></div><a class="button" href={href}>{cta}</a></article>
