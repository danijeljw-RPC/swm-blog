---
import type { EpisodeData } from "../../types/episode";
interface Props { episode: EpisodeData; }
const { episode } = Astro.props;
---
{episode.audio && (
  <section class="audio-player" aria-labelledby="audio-heading">
    <h2 id="audio-heading">Listen to episode {episode.episode}</h2>
    <audio controls preload="metadata">
      <source src={episode.audio.url} type={episode.audio.mimeType} />
      Your browser does not support the audio element.
    </audio>
    <a href={episode.audio.url} target="_blank" rel="noopener noreferrer">Open audio file</a>
  </section>
)}
<style>
  .audio-player { margin-block: var(--space-5); padding: var(--space-4); border: 1px solid var(--swm-border); }
  h2 { font-size: 1.6rem; }
  audio { width: 100%; margin-bottom: var(--space-2); }
  a { font-size: 0.8rem; }
</style>
