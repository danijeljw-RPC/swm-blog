---
import type { EpisodeData } from "../../types/episode";
interface Props { episode: EpisodeData; }
const { episode } = Astro.props;
---
{episode.audio && (
  <section id="episode-audio" class="audio-player" aria-label={`Listen to episode ${episode.episode}`}>
    <audio controls preload="metadata">
      <source src={episode.audio.url} type={episode.audio.mimeType} />
      Your browser does not support the audio element.
    </audio>
  </section>
)}
<style>
  .audio-player { margin-top: var(--space-4); scroll-margin-top: var(--space-4); }
  audio { width: 100%; }
</style>
