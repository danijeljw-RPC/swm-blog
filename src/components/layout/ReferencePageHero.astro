---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<header class="reference-page-hero site-container">
  <p>{eyebrow}</p>
  <h1>{title}</h1>
  <span aria-hidden="true"></span>
  <p>{description}</p>
</header>

<style>
  .reference-page-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 4rem minmax(0, 1fr);
    align-items: end;
    gap: var(--space-3);
    padding-block: clamp(2rem, 7vw, 6rem) var(--space-5);
  }

  .reference-page-hero > p:first-child {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--swm-gold);
    font-size: .75rem;
    letter-spacing: .13em;
    text-transform: uppercase;
  }

  .reference-page-hero h1 {
    margin: 0;
    font-size: clamp(3.2rem, 8vw, 6.5rem);
  }

  .reference-page-hero > span {
    height: 9rem;
    background: linear-gradient(var(--swm-gold), transparent);
    clip-path: polygon(49% 0, 51% 0, 51% 100%, 49% 100%);
  }

  .reference-page-hero > p:last-child {
    max-width: 27rem;
    margin: 0 0 .45rem;
    color: var(--swm-text-muted);
  }

  @media (max-width: 41.99rem) {
    .reference-page-hero { grid-template-columns: 1fr; }
    .reference-page-hero > span { display: none; }
  }
</style>
